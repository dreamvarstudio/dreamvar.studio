# Variables de entorno para desarrollo local / Vercel

# 1. Base de datos Vercel / Neon Postgres (obligatoria)
# La obtienes al crear la base de datos en Vercel Dashboard -> Storage -> Neon Postgres
DATABASE_URL="postgres://usuario:password@endpoint.neon.tech/neondb?sslmode=require"

# 2. Brevo API (para email transaccional de bienvenida)
# La obtienes en Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=""

# 3. ID de lista en Brevo (opcional, si quieres que los contactos se guarden en una lista específica)
BREVO_LIST_ID=""
