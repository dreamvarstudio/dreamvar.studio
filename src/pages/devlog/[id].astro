---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('devlog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} · DreamVar Studio`} description={post.data.summary}>
  <article class="article wrap">
    <a class="article__back" href="/#devlog">← Volver al devlog</a>
    <p class="label"><span class="article__tag">{post.data.tag}</span> · <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt.format(post.data.date)}</time></p>
    <h1 class="h-hand article__title">{post.data.title}</h1>
    <p class="article__summary">{post.data.summary}</p>
    <div class="article__body"><Content /></div>
  </article>
</Base>

<style>
  .article { max-width: calc(720px + 2 * var(--gutter)); padding-block: calc(140px + env(safe-area-inset-top, 0px)) clamp(80px, 10vw, 140px); display: grid; gap: 16px; }
  .article__back { font-family: var(--font-hand); font-size: 22px; text-decoration: none; margin-bottom: 18px; }
  .article__tag { color: var(--lamp); }
  .article__title { font-size: clamp(44px, 6vw, 72px); }
  .article__summary { margin: 0 0 18px; font-size: 22px; font-style: italic; color: var(--text-soft); text-wrap: pretty; }
  .article__body { font-size: 20px; line-height: 1.7; border-top: 1px solid var(--line); padding-top: 28px; }
  .article__body :global(h2) { font-family: var(--font-hand); font-weight: 400; font-size: 36px; margin: 1.4em 0 .4em; line-height: 1.1; }
  .article__body :global(p), .article__body :global(ul) { margin: 0 0 1em; text-wrap: pretty; }
  .article__body :global(li) { margin-bottom: .3em; }
  .article__body :global(li::marker) { color: var(--lamp); }
  .article__body :global(strong) { color: var(--text); }
  .article__body :global(em) { color: var(--rem); }
</style>
