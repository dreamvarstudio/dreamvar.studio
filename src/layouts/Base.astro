---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; image?: string }
const {
  title = 'DreamVar Studio · Duermevela: Rem y el Mar de Sueños',
  description = 'DreamVar Studio es un estudio independiente de videojuegos. Su primer juego, Duermevela: Rem y el Mar de Sueños, es un metroidvania 2D con demo en el Steam Next Fest de febrero de 2027.',
  image = '/img/og.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#131B30">
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="DreamVar Studio">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="es_MX">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href="/fonts/patrick-hand.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/alegreya.woff2" as="font" type="font/woff2" crossorigin>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <Header />
  <main id="contenido"><slot /></main>
  <Footer />
</body>
</html>

<style is:global>
  .skip {
    position: fixed; top: 8px; left: 8px; z-index: 200; padding: 10px 16px;
    background: var(--lamp); color: #2A1C0C; font-weight: 700; text-decoration: none;
    transform: translateY(-200%); transition: transform .2s;
  }
  .skip:focus { transform: none; }
</style>
