---
// Nota de papel con bordes rasgados. El rasgado se genera a partir de `seed`,
// así cada nota es distinta pero no cambia entre builds.
interface Props { seed?: number; tilt?: number; class?: string; as?: string }
const { seed = 1, tilt = 0, class: cls = '', as: Tag = 'div' } = Astro.props;

function rand(s: number) { let x = s; return () => (x = (x * 16807) % 2147483647) / 2147483647; }
const r = rand(seed * 7919 + 13);
const pts: string[] = [];
const step = 4;
for (let x = 0; x <= 100; x += step) pts.push(`${x}% ${(r() * 5).toFixed(1)}px`);
for (let y = step; y <= 100 - step; y += step * 2) pts.push(`calc(100% - ${(r() * 3).toFixed(1)}px) ${y}%`);
for (let x = 100; x >= 0; x -= step) pts.push(`${x}% calc(100% - ${(r() * 6).toFixed(1)}px)`);
for (let y = 100 - step; y >= step; y -= step * 2) pts.push(`${(r() * 3).toFixed(1)}px ${y}%`);
const torn = `polygon(${pts.join(',')})`;
---
<Tag class:list={['note', cls]} style={`--tilt:${tilt}deg;--torn:${torn}`}>
  <div class="note__paper"><slot /></div>
</Tag>
