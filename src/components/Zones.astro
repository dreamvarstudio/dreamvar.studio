---
import { Image } from 'astro:assets';
import umbral from '../assets/shots/umbral.png';
import refugio from '../assets/shots/refugio.png';
import cienaga from '../assets/shots/cienaga.png';
import ciudadela from '../assets/shots/ciudadela.png';
import sanatorio from '../assets/shots/sanatorio.png';
import bosque from '../assets/shots/bosque.png';
import taller from '../assets/shots/taller.png';
import archivo from '../assets/shots/archivo.png';
import catedral from '../assets/shots/catedral.png';
import jardin from '../assets/shots/jardin.png';

// En el orden del descenso. Los lemas son los que aparecen en el juego al entrar a cada zona.
const zones = [
  { img: umbral, name: 'El Umbral', motto: 'donde empieza la oscuridad' },
  { img: refugio, name: 'El Refugio de Nana', motto: 'entre el sueño y la vigilia' },
  { img: cienaga, name: 'La Ciénaga de los Pendientes', motto: 'donde el tiempo nunca alcanza' },
  { img: ciudadela, name: 'La Ciudadela del Abandono', motto: 'donde nadie vuelve' },
  { img: sanatorio, name: 'El Sanatorio de las Horas Blancas', motto: 'donde nadie se recupera' },
  { img: bosque, name: 'El Bosque de los Mil Ojos', motto: 'donde todos te miran' },
  { img: taller, name: 'El Taller de Rostros', motto: 'donde te cambian la cara' },
  { img: archivo, name: 'El Archivo del Olvido', motto: 'donde se borran los nombres' },
  { img: catedral, name: 'La Catedral del Insomnio', motto: 'donde nadie duerme', optional: true },
  { img: jardin, name: 'El Jardín de Nana', motto: 'donde nadie tiene miedo', optional: true },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="section zones" id="subsomnia" aria-labelledby="zones-title">
  <div class="wrap zones__head">
    <div class="section__head">
      <p class="label">Subsomnia</p>
      <h2 class="h-hand h2" id="zones-title">Cada zona es el sueño de alguien</h2>
      <p>Del cuarto de Nico hasta el fondo del mar de sueños. Capturas del juego en desarrollo.</p>
    </div>
    <div class="zones__ctrl">
      <span class="zones__count" id="zoneCount" aria-live="polite">01 / {pad(zones.length)}</span>
      <button class="zones__btn" type="button" id="zonePrev" aria-label="Zona anterior" disabled>
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M7 1 1 7l6 6M1 7h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button class="zones__btn" type="button" id="zoneNext" aria-label="Zona siguiente">
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="m11 1 6 6-6 6M17 7H1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>

  <ol class="zones__strip" id="zoneStrip" tabindex="0" aria-label="Zonas de Subsomnia">
    {zones.map((z) => (
      <li class="zone">
        <figure>
          <div class="zone__img">
            <Image src={z.img} alt={`Rem en ${z.name}`} widths={[640, 960, 1280]} sizes="(max-width: 900px) 84vw, 720px" quality={78} format="webp" />
          </div>
          <figcaption>
            <span class="zone__name h-hand">{z.name}</span>
            <span class="zone__motto">{z.motto}{z.optional && <span class="zone__opt"> · zona opcional</span>}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>

<script>
  const strip = document.getElementById('zoneStrip')!;
  const count = document.getElementById('zoneCount')!;
  const prev = document.getElementById('zonePrev') as HTMLButtonElement;
  const next = document.getElementById('zoneNext') as HTMLButtonElement;
  const items = [...strip.children] as HTMLElement[];
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  const current = () => {
    const left = strip.getBoundingClientRect().left + parseFloat(getComputedStyle(strip).paddingLeft);
    let best = 0, dist = Infinity;
    items.forEach((it, i) => {
      const d = Math.abs(it.getBoundingClientRect().left - left);
      if (d < dist) { dist = d; best = i; }
    });
    return best;
  };
  const update = () => {
    const end = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
    count.textContent = `${pad(end ? items.length : current() + 1)} / ${pad(items.length)}`;
    prev.disabled = strip.scrollLeft <= 4;
    next.disabled = end;
  };
  const go = (dir: number) => {
    const i = Math.max(0, Math.min(items.length - 1, current() + dir));
    strip.scrollTo({ left: items[i].offsetLeft - items[0].offsetLeft, behavior: calm ? 'auto' : 'smooth' });
  };
  prev.addEventListener('click', () => go(-1));
  next.addEventListener('click', () => go(1));
  strip.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
  });
  let raf = 0;
  strip.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
  addEventListener('resize', update);
  update();
</script>

<style>
  .zones__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; }
  .zones__head .section__head { margin-bottom: 0; }
  .zones__ctrl { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
  .zones__count { font-family: var(--font-hand); font-size: 22px; color: var(--text-soft); min-width: 64px; font-variant-numeric: tabular-nums; }
  .zones__btn {
    width: 50px; height: 50px; border-radius: 50%; border: 1.5px solid rgba(242, 185, 108, .55);
    background: transparent; color: var(--lamp); display: grid; place-items: center; cursor: pointer;
    transition: background .25s, color .25s, opacity .25s;
  }
  .zones__btn:hover:not(:disabled) { background: var(--lamp); color: #2A1C0C; }
  .zones__btn:disabled { opacity: .3; cursor: default; }

  .zones__strip {
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    list-style: none; margin: clamp(32px, 4vw, 48px) 0 0; padding: 0 var(--edge) 12px;
    display: flex; gap: clamp(14px, 2vw, 24px);
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    scrollbar-width: none;
  }
  .zones__strip::-webkit-scrollbar { display: none; }
  .zones__strip::after { content: ''; flex: 0 0 1px; }
  .zones__strip:focus-visible { outline-offset: -2px; }
  .zone { flex: 0 0 min(84vw, 720px); scroll-snap-align: start; }
  .zone figure { margin: 0; display: grid; gap: 16px; }
  .zone__img { aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; background: var(--night-raise); box-shadow: 0 18px 40px rgba(0, 0, 0, .45); }
  .zone__img img { width: 100%; height: 100%; object-fit: cover; }
  .zone figcaption { display: grid; gap: 2px; }
  .zone__name { font-size: clamp(24px, 2.4vw, 30px); color: var(--text); }
  .zone__motto { font-style: italic; color: var(--text-soft); font-size: 18px; }
  .zone__opt { font-style: normal; font-family: var(--font-label); font-size: 15px; color: var(--text-faint); }
</style>
